{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#ececfd",
    "primaryTextColor": "#1c1c2e",
    "primaryBorderColor": "#4c4ce0",
    "secondaryColor": "#f2f2f7",
    "secondaryTextColor": "#1c1c2e",
    "secondaryBorderColor": "#a8a8c4",
    "tertiaryColor": "#ffffff",
    "tertiaryTextColor": "#1c1c2e",
    "tertiaryBorderColor": "#d0d0e0",
    "lineColor": "#5b5bf5",
    "textColor": "#1c1c2e",
    "mainBkg": "#ececfd",
    "nodeBorder": "#4c4ce0",
    "clusterBkg": "#f7f7fb",
    "clusterBorder": "#d0d0e0",
    "edgeLabelBackground": "#ffffff",
    "titleColor": "#1c1c2e",
    "actorBkg": "#ececfd",
    "actorBorder": "#4c4ce0",
    "actorTextColor": "#1c1c2e",
    "actorLineColor": "#a8a8c4",
    "signalColor": "#1c1c2e",
    "signalTextColor": "#1c1c2e",
    "sequenceNumberColor": "#ffffff",
    "labelBoxBkgColor": "#ececfd",
    "labelBoxBorderColor": "#4c4ce0",
    "labelTextColor": "#1c1c2e",
    "loopTextColor": "#1c1c2e",
    "noteBkgColor": "#fff7d6",
    "noteBorderColor": "#e0c85a",
    "noteTextColor": "#1c1c2e",
    "sectionBkgColor": "#f7f7fb",
    "altSectionBkgColor": "#ffffff",
    "sectionBkgColor2": "#f2f2f7",
    "taskBkgColor": "#ececfd",
    "taskBorderColor": "#4c4ce0",
    "taskTextColor": "#1c1c2e",
    "taskTextOutsideColor": "#1c1c2e",
    "taskTextDarkColor": "#1c1c2e",
    "activeTaskBkgColor": "#9d9df3",
    "activeTaskBorderColor": "#4c4ce0",
    "doneTaskBkgColor": "#dcdcea",
    "doneTaskBorderColor": "#a8a8c4",
    "critBkgColor": "#ffe8c4",
    "critBorderColor": "#d9963f",
    "gridColor": "#d0d0e0",
    "todayLineColor": "#d9963f"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 12,
    "nodeSpacing": 45,
    "rankSpacing": 55,
    "useMaxWidth": true
  },
  "sequence": {
    "useMaxWidth": true,
    "wrap": false
  },
  "gantt": {
    "useMaxWidth": true,
    "leftPadding": 130,
    "barHeight": 22,
    "barGap": 6,
    "fontSize": 14,
    "sectionFontSize": 14
  }
}
