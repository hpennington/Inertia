{
  "theme": "base",
  "themeVariables": {
    "darkMode": true,
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#2f2f4d",
    "primaryTextColor": "#e8e8f6",
    "primaryBorderColor": "#8a8aff",
    "secondaryColor": "#26262f",
    "secondaryTextColor": "#e8e8f6",
    "secondaryBorderColor": "#4a4a5c",
    "tertiaryColor": "#1e1f29",
    "tertiaryTextColor": "#e8e8f6",
    "tertiaryBorderColor": "#4a4a5c",
    "lineColor": "#8a8aff",
    "textColor": "#dcdce8",
    "mainBkg": "#2f2f4d",
    "nodeBorder": "#8a8aff",
    "clusterBkg": "#23242e",
    "clusterBorder": "#4a4a5c",
    "edgeLabelBackground": "#1e1f29",
    "titleColor": "#e8e8f6",
    "actorBkg": "#2f2f4d",
    "actorBorder": "#8a8aff",
    "actorTextColor": "#e8e8f6",
    "actorLineColor": "#5a5a70",
    "signalColor": "#dcdce8",
    "signalTextColor": "#dcdce8",
    "sequenceNumberColor": "#1e1f29",
    "labelBoxBkgColor": "#2f2f4d",
    "labelBoxBorderColor": "#8a8aff",
    "labelTextColor": "#e8e8f6",
    "loopTextColor": "#dcdce8",
    "noteBkgColor": "#3a3524",
    "noteBorderColor": "#8a7a3a",
    "noteTextColor": "#e8e8f6",
    "sectionBkgColor": "#23242e",
    "altSectionBkgColor": "#1e1f29",
    "sectionBkgColor2": "#26262f",
    "taskBkgColor": "#2f2f4d",
    "taskBorderColor": "#8a8aff",
    "taskTextColor": "#e8e8f6",
    "taskTextOutsideColor": "#dcdce8",
    "taskTextDarkColor": "#e8e8f6",
    "taskTextLightColor": "#e8e8f6",
    "activeTaskBkgColor": "#4a4ad6",
    "activeTaskBorderColor": "#8a8aff",
    "doneTaskBkgColor": "#3a3a48",
    "doneTaskBorderColor": "#5a5a70",
    "critBkgColor": "#4a3a22",
    "critBorderColor": "#c9913f",
    "gridColor": "#3a3a48",
    "todayLineColor": "#c9913f"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 12,
    "nodeSpacing": 45,
    "rankSpacing": 55,
    "useMaxWidth": true
  },
  "sequence": {
    "useMaxWidth": true,
    "wrap": false
  },
  "gantt": {
    "useMaxWidth": true,
    "leftPadding": 130,
    "barHeight": 22,
    "barGap": 6,
    "fontSize": 14,
    "sectionFontSize": 14
  }
}
